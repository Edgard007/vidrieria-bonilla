# Copy this file to .env and fill in the values for your environment.
# Variables prefixed with PUBLIC_ end up in the browser bundle: never put secrets in them.

# Production domain, used for canonical URLs, hreflang, the sitemap, robots.txt and Open Graph.
# Optional: defaults to https://vidrieriabonilla.com when unset.
SITE_URL=https://vidrieriabonilla.com

# Form delivery endpoint (Formspree, Web3Forms or any service accepting a POST of FormData).
# Optional: when empty, the quote form hands the request to WhatsApp instead.
# Example: https://formspree.io/f/your-form-id
PUBLIC_FORM_ENDPOINT=

# Google Search Console verification, HTML tag method: paste only the content value of the
# google-site-verification meta tag. Optional: leave empty if the domain is verified by DNS.
PUBLIC_GSC_VERIFICATION=
