---
import type { HTMLAttributes } from 'astro/types';

type Props = {
  id: string;
  name: string;
  label: string;
  hint?: string;
  optionalLabel?: string;
  as?: 'input' | 'textarea' | 'select';
} & Omit<
  HTMLAttributes<'input'> & HTMLAttributes<'textarea'> & HTMLAttributes<'select'>,
  'id' | 'name'
>;

const { id, name, label, hint, optionalLabel, as = 'input', required, ...rest } = Astro.props;
const hintId = hint ? `${id}-hint` : undefined;
const errorId = `${id}-error`;
const describedBy = [hintId, errorId].filter(Boolean).join(' ');
const shared = { id, name, required, 'aria-describedby': describedBy, ...rest };
---

<div class="field" data-field={name}>
  <label class="field__label" for={id}>
    {label}
    {optionalLabel && <span class="field__optional">({optionalLabel})</span>}
  </label>
  {hint && (
    <p id={hintId} class="field__hint">
      {hint}
    </p>
  )}
  {as === 'textarea' && <textarea
    class="field__control field__control--area"
    rows="5"
    {...shared}
  ></textarea>}
  {as === 'select' && (
    <div class="field__select">
      <select class="field__control" {...shared}>
        <slot />
      </select>
    </div>
  )}
  {as === 'input' && <input class="field__control" {...shared} />}
  <p id={errorId} class="field__error" data-error-for={name} hidden></p>
</div>

<style>
  .field {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .field__label {
    font-size: var(--text-label);
    font-weight: 620;
  }

  .field__optional {
    margin-left: var(--space-2);
    color: var(--color-on-surface-muted);
    font-weight: 450;
  }

  .field__hint {
    margin-top: calc(-1 * var(--space-1));
    color: var(--color-on-surface-muted);
    font-size: var(--text-sm);
  }

  .field__control {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-outline-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface-raised);
    color: var(--color-on-surface);
    font-size: var(--text-md);
    line-height: 1.4;
    transition:
      border-color var(--dur-feedback) var(--ease-out),
      box-shadow var(--dur-feedback) var(--ease-out);
  }

  .field__control:hover {
    border-color: var(--color-on-surface-muted);
  }

  .field__control:focus-visible {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-primary) 28%, transparent);
  }

  .field__control[aria-invalid='true'] {
    border-color: var(--color-error);
  }

  .field__control--area {
    min-height: 8.5rem;
    resize: vertical;
  }

  .field__select {
    position: relative;
  }

  .field__select::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 1rem;
    width: 8px;
    height: 8px;
    border-right: 1.5px solid var(--color-on-surface);
    border-bottom: 1.5px solid var(--color-on-surface);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  .field__select select {
    padding-right: 2.5rem;
    appearance: none;
  }

  .field__error {
    color: var(--color-error);
    font-size: var(--text-label);
    font-weight: 560;
  }
</style>
