---
import { Share2 } from '@lucide/astro';

import type { Locale } from '@/i18n/locales';
import { UI } from '@/i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  class?: string;
}

const { locale, title, class: className } = Astro.props;
const ui = UI[locale];
---

<span class:list={['share', className]} data-share>
  <button
    type="button"
    class="share__button"
    data-share-button
    data-share-title={title}
    data-copied={ui.share.copied}
    data-failed={ui.share.failed}
  >
    <Share2 aria-hidden="true" />
    <span>{ui.share.button}</span>
  </button>
  <span class="share__status" role="status" aria-live="polite" data-share-status></span>
</span>

<script>
  // Native share sheet where available (most phones); elsewhere the page link is copied.
  document.querySelectorAll<HTMLElement>('[data-share]').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('[data-share-button]');
    const status = root.querySelector<HTMLElement>('[data-share-status]');
    if (!button || !status) return;

    const announce = (message: string): void => {
      status.textContent = message;
      window.setTimeout(() => {
        status.textContent = '';
      }, 3000);
    };

    button.addEventListener('click', async () => {
      const url = window.location.href.split('#')[0] ?? window.location.href;
      const title = button.dataset.shareTitle ?? document.title;
      if (navigator.share) {
        try {
          await navigator.share({ title, url });
        } catch (error) {
          // Closing the share sheet rejects with AbortError; that is not a failure to report.
          if (error instanceof DOMException && error.name === 'AbortError') return;
          console.error('Share failed', error);
          announce(button.dataset.failed ?? '');
        }
        return;
      }
      try {
        await navigator.clipboard.writeText(url);
        announce(button.dataset.copied ?? '');
      } catch (error) {
        console.error('Copy failed', error);
        announce(button.dataset.failed ?? '');
      }
    });
  });
</script>

<style>
  .share {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .share__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-deep-line);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-on-deep);
    font-size: var(--text-label);
    font-weight: 620;
    transition: border-color var(--dur-feedback) var(--ease-out);
  }

  .share__button:hover {
    border-color: var(--color-on-deep);
  }

  .share__button :global(svg) {
    width: 18px;
    height: 18px;
  }

  .share__status {
    color: var(--color-accent-on-deep);
    font-size: var(--text-sm);
    font-weight: 600;
  }
</style>
