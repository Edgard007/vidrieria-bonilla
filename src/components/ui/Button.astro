---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'on-deep';

type Props = {
  variant?: Variant;
  href?: string;
  isExternal?: boolean;
  size?: 'md' | 'lg';
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'href'>;

const {
  variant = 'primary',
  href,
  isExternal = false,
  size = 'md',
  class: className,
  ...rest
} = Astro.props;

const classes = ['button', `button--${variant}`, `button--${size}`, className];
const externalAttributes = isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{href ? (
  <a href={href} class:list={classes} {...externalAttributes} {...rest}>
    <slot />
  </a>
) : (
  <button class:list={classes} {...rest}>
    <slot />
  </button>
)}

<style>
  .button {
    --button-bg: var(--color-primary);
    --button-fg: var(--color-on-primary);
    --button-border: transparent;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: 0.8rem 1.35rem;
    border: 1px solid var(--button-border);
    border-radius: var(--radius-sm);
    background: var(--button-bg);
    color: var(--button-fg);
    font-size: var(--text-label);
    font-weight: 620;
    font-stretch: 104%;
    line-height: 1.2;
    letter-spacing: 0.005em;
    text-decoration: none;
    text-align: center;
    isolation: isolate;
    overflow: hidden;
    transition:
      background-color var(--dur-feedback) var(--ease-out),
      border-color var(--dur-feedback) var(--ease-out),
      transform var(--dur-feedback) var(--ease-out);
  }

  /* A sheen crosses the button like light across a pane; it never loops. */
  .button::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      transparent 30%,
      color-mix(in oklab, white 22%, transparent) 50%,
      transparent 70%
    );
    transform: translateX(-110%);
    pointer-events: none;
  }

  /* Labels stay on one line wherever there is room; very narrow phones may wrap them. */
  @media (min-width: 24rem) {
    .button {
      white-space: nowrap;
    }
  }

  .button--lg {
    min-height: 54px;
    padding: 0.95rem 1.6rem;
    font-size: var(--text-md);
  }

  .button :global(svg) {
    width: 1.15em;
    height: 1.15em;
    flex: none;
  }

  .button--primary:hover {
    --button-bg: var(--color-primary-hover);
  }

  .button--secondary {
    --button-bg: var(--color-surface-raised);
    --button-fg: var(--color-on-surface);
    --button-border: var(--color-outline-strong);
  }

  .button--secondary:hover {
    --button-border: var(--color-on-surface);
  }

  .button--on-deep {
    --button-bg: var(--color-on-deep);
    --button-fg: var(--color-deep);
  }

  .button--on-deep:hover {
    --button-bg: #ffffff;
  }

  .button:active {
    transform: translateY(1px);
  }

  .button:disabled,
  .button[aria-disabled='true'] {
    cursor: not-allowed;
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: no-preference) {
    .button:hover::after {
      transform: translateX(110%);
      transition: transform var(--dur-focal) var(--ease-out);
    }
  }
</style>
