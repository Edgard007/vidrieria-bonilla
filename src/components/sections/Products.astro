---
import { Image, Picture } from 'astro:assets';
import { ArrowRight, Check, Palette } from '@lucide/astro';

import Elevation from '@/components/ui/Elevation.astro';
import Button from '@/components/ui/Button.astro';
import { COMPANY } from '@/config/company';
import type { Locale } from '@/i18n/locales';
import { UI } from '@/i18n/ui';
import type { Product, ProductCategory } from '@/types/company';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const section = ui.sections.products;
const products: readonly Product[] = COMPANY.products;
const CATEGORY_ORDER: ProductCategory[] = ['windows', 'doors', 'mirrors', 'custom'];
const groups = CATEGORY_ORDER.map((category) => ({
  category,
  items: products.filter((product) => product.category === category),
})).filter((group) => group.items.length > 0);

// Only the checked product's panel shows, driven by CSS so the catalog works without JavaScript.
const panelVisibilityCss = `${products
  .map((product) => `.catalog:has(#product-${product.id}:checked) [data-panel='${product.id}']`)
  .join(',')}{display:grid}`;
---

<style is:inline set:html={panelVisibilityCss}></style>

<section id={section.id} class="section products" aria-labelledby="products-title">
  <div class="container">
    <header class="products__header" data-reveal="rise">
      <span class="accent-rule" aria-hidden="true"></span>
      <h2 id="products-title" class="section-title">
        {section.title}
      </h2>
      {section.lede && <p class="section-lede">{section.lede}</p>}
    </header>

    <div class="catalog" data-catalog>
      <div
        class="catalog__index"
        role="radiogroup"
        aria-label={ui.products.listLabel}
        data-reveal="stagger"
      >
        {groups.map((group) => (
          <div class="catalog__group" data-reveal-item>
            <p class="catalog__group-label" aria-hidden="true">
              {ui.products.categories[group.category]}
            </p>
            <ul role="list">
              {group.items.map((product) => (
                <li>
                  <input
                    class="visually-hidden"
                    type="radio"
                    name="product"
                    id={`product-${product.id}`}
                    value={product.id}
                    checked={product.id === products[0]?.id}
                    data-product-radio
                  />
                  <label class="catalog__option" for={`product-${product.id}`}>
                    <span class="catalog__option-name">{product.name[locale]}</span>
                    {product.label && (
                      <span class="catalog__option-label">{product.label[locale]}</span>
                    )}
                  </label>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="catalog__panels">
        {products.map((product) => (
          <article
            class="panel"
            data-panel={product.id}
            aria-labelledby={`panel-title-${product.id}`}
          >
            <div class="panel__media" data-panel-media>
              <div class="panel__frame">
                {product.photos.length > 0 ? (
                  product.photos.map((photo, index) => (
                    <figure
                      class="panel__photo skeleton"
                      data-photo={index}
                      data-active={index === 0 ? '' : undefined}
                    >
                      <Picture
                        src={photo.src}
                        alt={photo.alt[locale]}
                        formats={['avif', 'webp']}
                        widths={[420, 640, 900]}
                        sizes="(min-width: 64rem) 40vw, 92vw"
                      />
                    </figure>
                  ))
                ) : (
                  <div class="panel__drawing">
                    <Elevation kind={product.elevation} />
                  </div>
                )}
              </div>
              {product.photos.length > 1 && (
                <div class="panel__thumbs" role="group" aria-label={product.name[locale]}>
                  {product.photos.map((photo, index) => (
                    <button
                      type="button"
                      class="panel__thumb skeleton"
                      data-thumb={index}
                      aria-label={ui.products.showPhoto(index + 1)}
                      aria-pressed={index === 0 ? 'true' : 'false'}
                    >
                      <Image
                        src={photo.src}
                        alt={photo.alt[locale]}
                        width={96}
                        height={96}
                        densities={[1, 2]}
                      />
                    </button>
                  ))}
                </div>
              )}
              {product.photos.length === 0 && (
                <p class="panel__note">{ui.products.photoFallback}</p>
              )}
            </div>

            <div class="panel__body">
              {product.label && <span class="panel__label">{product.label[locale]}</span>}
              <h3 id={`panel-title-${product.id}`} class="panel__title">
                {product.name[locale]}
              </h3>
              <p class="panel__summary">{product.summary[locale]}</p>
              <h4 class="panel__features-title">{ui.products.features}</h4>
              <ul class="panel__features" role="list">
                {product.features[locale].map((feature) => (
                  <li>
                    <Check aria-hidden="true" />
                    {feature}
                  </li>
                ))}
              </ul>
              <div class="panel__actions">
                <Button href={`#${ui.sections.contact.id}`} data-quote-service={product.id}>
                  {ui.products.quote}
                  <ArrowRight aria-hidden="true" />
                </Button>
                {product.category !== 'mirrors' && (
                  <a class="panel__link" href={`#${ui.sections.materials.id}`}>
                    <Palette aria-hidden="true" />
                    {ui.products.seeColours}
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from 'motion';

  const catalog = document.querySelector<HTMLElement>('[data-catalog]');
  const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const EASE_OUT = [0.16, 1, 0.3, 1] as const;

  if (catalog) {
    catalog.querySelectorAll<HTMLInputElement>('[data-product-radio]').forEach((radio) => {
      radio.addEventListener('change', () => {
        const panel = catalog.querySelector<HTMLElement>(`[data-panel="${radio.value}"]`);
        if (!panel || isReducedMotion) return;
        const media = panel.querySelector('.panel__frame');
        const body = panel.querySelector('.panel__body');
        if (media) {
          animate(
            media,
            { opacity: [0, 1], clipPath: ['inset(0 0 0 30%)', 'inset(0 0 0 0%)'] },
            { duration: 0.7, ease: EASE_OUT },
          );
        }
        if (body) {
          animate(
            Array.from(body.children),
            { opacity: [0, 1], transform: ['translateY(14px)', 'translateY(0px)'] },
            { duration: 0.6, ease: EASE_OUT, delay: (index: number) => 0.08 + index * 0.04 },
          );
        }
      });
    });

    catalog.querySelectorAll<HTMLElement>('[data-panel-media]').forEach((media) => {
      const photos = Array.from(media.querySelectorAll<HTMLElement>('[data-photo]'));
      const thumbs = Array.from(media.querySelectorAll<HTMLButtonElement>('[data-thumb]'));
      thumbs.forEach((thumb, index) => {
        thumb.addEventListener('click', () => {
          photos.forEach((photo, i) => photo.toggleAttribute('data-active', i === index));
          thumbs.forEach((other, i) => other.setAttribute('aria-pressed', String(i === index)));
          const active = photos[index];
          if (active && !isReducedMotion) {
            animate(
              active,
              { opacity: [0, 1], scale: [1.03, 1] },
              { duration: 0.6, ease: EASE_OUT },
            );
          }
        });
      });
    });
  }
</script>

<style>
  .products__header {
    margin-bottom: var(--space-7);
  }

  .catalog {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: var(--space-7);
    align-items: start;
  }

  .catalog__index {
    position: sticky;
    top: calc(var(--header-height) + var(--space-5));
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  .catalog__group-label {
    margin-bottom: var(--space-2);
    color: var(--color-accent-ink);
    font-size: var(--text-sm);
    font-weight: 650;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Keeps the visually hidden radios inside the scrolling chip rail on small screens. */
  .catalog__group li {
    position: relative;
  }

  .catalog__group ul {
    display: grid;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--color-outline);
  }

  .catalog__option {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-4);
    color: var(--color-on-surface-muted);
    font-weight: 560;
    line-height: 1.3;
    cursor: pointer;
    transition:
      color var(--dur-feedback) var(--ease-out),
      background-color var(--dur-feedback) var(--ease-out);
  }

  .catalog__option::before {
    content: '';
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: -1px;
    width: 2px;
    border-radius: var(--radius-xs);
    background: var(--color-accent);
    transform: scaleY(0);
    transition: transform var(--dur-layout) var(--ease-out);
  }

  .catalog__option:hover {
    color: var(--color-on-surface);
    background: var(--color-surface-glass);
  }

  input:checked + .catalog__option {
    color: var(--color-on-surface);
    font-weight: 680;
  }

  input:checked + .catalog__option::before {
    transform: scaleY(1);
  }

  input:focus-visible + .catalog__option {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .catalog__option-label {
    flex: none;
    padding: 2px var(--space-2);
    border-radius: var(--radius-full);
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .catalog__panels {
    display: grid;
    min-width: 0;
  }

  .panel {
    display: none;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--space-6);
    align-items: start;
  }

  .panel__frame {
    display: grid;
    overflow: clip;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--color-outline);
    border-radius: var(--radius-lg);
    background: var(--color-surface-glass);
  }

  .panel__photo {
    grid-area: 1 / 1;
    display: grid;
    min-height: 0;
    visibility: hidden;
    opacity: 0;
  }

  .panel__photo[data-active] {
    visibility: visible;
    opacity: 1;
  }

  .panel__photo :global(picture) {
    display: grid;
    min-height: 0;
  }

  /* The whole photo is always visible: it is letterboxed inside the frame, never cropped. */
  .panel__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .panel__drawing {
    display: grid;
    place-items: center;
    padding: 16%;
  }

  .panel__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .panel__thumb {
    width: 64px;
    height: 64px;
    padding: 0;
    overflow: clip;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    background: var(--color-surface-glass);
    opacity: 0.7;
    transition:
      opacity var(--dur-feedback) var(--ease-out),
      border-color var(--dur-feedback) var(--ease-out);
  }

  .panel__thumb:hover,
  .panel__thumb[aria-pressed='true'] {
    opacity: 1;
  }

  .panel__thumb[aria-pressed='true'] {
    border-color: var(--color-accent);
  }

  .panel__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .panel__note {
    margin-top: var(--space-3);
    color: var(--color-on-surface-muted);
    font-size: var(--text-sm);
  }

  .panel__body {
    padding-top: var(--space-4);
  }

  .panel__label {
    display: inline-block;
    margin-bottom: var(--space-3);
    padding: 3px var(--space-3);
    border-radius: var(--radius-full);
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .panel__title {
    font-size: var(--text-h2);
    font-weight: 740;
    font-stretch: 114%;
  }

  .panel__summary {
    max-width: 40ch;
    margin-top: var(--space-4);
    color: var(--color-on-surface-muted);
    font-size: var(--text-lg);
  }

  .panel__features-title {
    margin-top: var(--space-6);
    font-size: var(--text-label);
    font-weight: 650;
    font-stretch: 100%;
    letter-spacing: 0.01em;
  }

  .panel__features {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .panel__features li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .panel__features :global(svg) {
    width: 18px;
    height: 18px;
    flex: none;
    margin-top: 0.25em;
    color: var(--color-accent);
  }

  .panel__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-6);
  }

  .panel__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    color: var(--color-primary);
    font-size: var(--text-label);
    font-weight: 620;
  }

  .panel__link :global(svg) {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 64rem) {
    .catalog {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }

    .catalog__index {
      position: static;
      display: flex;
      gap: var(--space-2);
      margin-inline: calc(-1 * var(--gutter));
      padding: 0 var(--gutter) var(--space-2);
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: thin;
    }

    .catalog__group {
      display: contents;
    }

    .catalog__group-label {
      display: none;
    }

    .catalog__group ul {
      display: flex;
      gap: var(--space-2);
      border-left: 0;
    }

    .catalog__option {
      flex: none;
      padding-inline: var(--space-4);
      border: 1px solid var(--color-outline);
      border-radius: var(--radius-full);
      background: var(--color-surface-raised);
      white-space: nowrap;
      scroll-snap-align: start;
    }

    .catalog__option::before {
      display: none;
    }

    input:checked + .catalog__option {
      border-color: var(--color-deep);
      background: var(--color-deep);
      color: var(--color-on-deep);
    }

    input:checked + .catalog__option .catalog__option-label {
      background: var(--color-accent-on-deep);
      color: var(--color-deep);
    }
  }

  @media (max-width: 40rem) {
    .panel {
      grid-template-columns: minmax(0, 1fr);
    }

    .panel__body {
      padding-top: 0;
    }
  }
</style>
