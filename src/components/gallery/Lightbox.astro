---
import { ChevronLeft, ChevronRight, X } from '@lucide/astro';

import type { Locale } from '@/i18n/locales';
import { UI } from '@/i18n/ui';

interface Props {
  locale: Locale;
  initial: { src: string; alt: string };
}

const { locale, initial } = Astro.props;
const ui = UI[locale];
const counterTemplate = ui.gallery.counter(0, 0).replace('0', '{current}').replace('0', '{total}');
---

<dialog class="lightbox" aria-label={ui.gallery.dialogLabel} data-lightbox>
  <div class="lightbox__stage">
    <img
      class="lightbox__image"
      src={initial.src}
      alt={initial.alt}
      loading="lazy"
      data-lightbox-image
    />
  </div>
  <div class="lightbox__bar">
    <p class="lightbox__caption" data-lightbox-caption></p>
    <p
      class="lightbox__counter tabular"
      aria-live="polite"
      data-lightbox-counter
      data-template={counterTemplate}
    ></p>
    <div class="lightbox__controls">
      <button
        type="button"
        class="lightbox__button"
        data-lightbox-prev
        aria-label={ui.gallery.previous}
      >
        <ChevronLeft aria-hidden="true" />
      </button>
      <button
        type="button"
        class="lightbox__button"
        data-lightbox-next
        aria-label={ui.gallery.next}
      >
        <ChevronRight aria-hidden="true" />
      </button>
      <button
        type="button"
        class="lightbox__button"
        data-lightbox-close
        aria-label={ui.gallery.close}
      >
        <X aria-hidden="true" />
      </button>
    </div>
  </div>
</dialog>

<script>
  type Slide = { src: string; alt: string; caption: string };

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-gallery-index]'));

  if (dialog && links.length > 0) {
    const image = dialog.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]');
    const counter = dialog.querySelector<HTMLElement>('[data-lightbox-counter]');
    const slides: Slide[] = links.map((link) => ({
      src: link.dataset.full ?? link.href,
      alt: link.dataset.alt ?? '',
      caption: link.dataset.caption ?? '',
    }));
    let current = 0;

    const show = (index: number): void => {
      current = (index + slides.length) % slides.length;
      const slide = slides[current];
      if (!slide || !image || !caption || !counter) return;
      image.src = slide.src;
      image.alt = slide.alt;
      caption.textContent = slide.caption;
      counter.textContent = (counter.dataset.template ?? '')
        .replace('{current}', String(current + 1))
        .replace('{total}', String(slides.length));
    };

    links.forEach((link, index) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        show(index);
        dialog.showModal();
      });
    });

    dialog
      .querySelector('[data-lightbox-prev]')
      ?.addEventListener('click', () => show(current - 1));
    dialog
      .querySelector('[data-lightbox-next]')
      ?.addEventListener('click', () => show(current + 1));
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });

    // A click on the backdrop lands on the dialog element itself.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .lightbox {
    width: min(100% - 2 * var(--gutter), 72rem);
    max-width: none;
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--color-deep);
    color: var(--color-on-deep);
    overflow: hidden;
    opacity: 1;
    transform: none;
    transition:
      opacity var(--dur-state) var(--ease-out),
      transform var(--dur-layout) var(--ease-out),
      display var(--dur-layout) allow-discrete,
      overlay var(--dur-layout) allow-discrete;
  }

  .lightbox:not([open]) {
    opacity: 0;
    transform: scale(0.98);
    transition-duration: var(--dur-feedback);
  }

  @starting-style {
    .lightbox[open] {
      opacity: 0;
      transform: scale(0.97) translateY(12px);
    }
  }

  .lightbox::backdrop {
    background: color-mix(in oklab, var(--color-deep) 86%, transparent);
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
  }

  .lightbox__stage {
    display: grid;
    place-items: center;
    min-height: 0;
    background: color-mix(in oklab, var(--color-deep) 70%, black);
  }

  .lightbox__image {
    max-width: 100%;
    max-height: calc(100dvh - 8rem);
    object-fit: contain;
  }

  .lightbox__bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-5);
  }

  .lightbox__caption {
    font-weight: 560;
  }

  .lightbox__counter {
    color: var(--color-on-deep-muted);
    font-size: var(--text-label);
  }

  .lightbox__controls {
    display: flex;
    gap: var(--space-2);
  }

  .lightbox__button {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-deep-line);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-on-deep);
    transition: background-color var(--dur-feedback) var(--ease-out);
  }

  .lightbox__button:hover {
    background: var(--color-deep-line);
  }

  .lightbox__button:focus-visible {
    outline-color: var(--color-on-deep);
  }

  .lightbox__button :global(svg) {
    width: 22px;
    height: 22px;
  }

  @media (max-width: 36rem) {
    .lightbox__bar {
      grid-template-columns: minmax(0, 1fr) auto;
      padding-left: var(--space-4);
    }

    .lightbox__controls {
      grid-column: 1 / -1;
      justify-content: space-between;
    }
  }
</style>
